# Export locally, or explicitly pass this file using uv's --env-file option.
# No automatic dotenv loading and no credentials committed.
RELAY_ENV=local
# RELAY_DB=workbench/.runtime/relay.sqlite
# Optional reference database; never point it at the baseline database.
# RELAY_REFERENCE_DB=workbench/.runtime/c1.sqlite
# Live reference/evaluation requires all three; baseline stays fixture regardless.
# RELAY_ALLOW_LIVE=1
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Langfuse export remains opt-in; do not enable without a reviewed data policy.
# RELAY_TRACE_EXPORT=1
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# Prepared RAG reference only. Index explicitly before starting contact1:live.
# Defaults: OpenAI text-embedding-3-small, 1536 dimensions, local persistent Qdrant.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# RELAY_EMBEDDING_DIMENSIONS=1536
# RELAY_VECTOR_PATH=workbench/.runtime/c1-vector
# RELAY_RETRIEVAL_MODE=hybrid
# Live default: vector + permissioned lexical RRF retrieval; set vector for comparison.
# RELAY_VECTOR_MIN_SCORE=0.4
# This threshold is an uncalibrated starting point; review live held-out results.
# Application-linked framework comparison; use a separate vector path after changing chunker.
# RELAY_CHUNKER=langchain
# Optional controls: configure only those supported by the chosen model.
# OPENAI_REASONING_EFFORT=low
# OPENAI_VERBOSITY=low
# OPENAI_PROMPT_CACHE_KEY=relay-contact1

# Choose one billing route. Direct OpenAI is the default; keys are never shared.
# RELAY_AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OpenRouter defaults to a separate .runtime/c1-vector-openrouter index.
# Native Conversations / previous_response_id demos require direct OpenAI access.

# Hosted workshop only (normal startup stays local; production is unsupported).
# Render supplies RENDER_EXTERNAL_URL automatically; elsewhere set this exact HTTPS origin:
# RELAY_PUBLIC_ORIGIN=https://your-workshop.example
# RELAY_ENV=workshop
# RELAY_PROFILE=live
# RELAY_DATA_DIR=/data
# RELAY_BOOTSTRAP_INDEX=1
# RELAY_WORKSHOP_MINUTE_RUN_LIMIT=10
# RELAY_WORKSHOP_DAILY_RUN_LIMIT=100
